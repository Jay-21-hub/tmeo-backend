# TMEO backend — environment variable TEMPLATE (names + placeholders only).
# Copy to .env for local work. On Render, set these in Environment (never commit real values).

# ── Required ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=<your-service>.onrender.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Database: Supabase SESSION POOLER (preferred) ───────────────────────────
# Copy the exact values from Supabase Dashboard -> Connect -> "Session pooler".
# Session pooler = pooler host, port 5432, user "postgres.<project-ref>". IPv4-safe, full feature support.
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_HOST=aws-<n>-<region>.pooler.supabase.com
DB_PORT=5432
# Leave these two UNSET with the session pooler (defaults: 0 / False).
# DB_CONN_MAX_AGE=0
# Set True ONLY if you switch to the TRANSACTION pooler (port 6543); server-side cursors
# (.iterator()) do not survive transaction pooling. Run `migrate` over session/direct, not 6543.
# DB_DISABLE_SERVER_SIDE_CURSORS=True

# ── Frontend / CORS / CSRF ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://<project>.vercel.app
FRONTEND_URL=https://<project>.vercel.app
# CSRF_TRUSTED_ORIGINS=https://<service>.onrender.com
# CORS_ALLOWED_ORIGIN_REGEXES=

# ── Proxy (verify on the deployed service first — see deployment guide section 4) ──
# NUM_PROXIES=

# ── Email (Render Free blocks SMTP; use a paid instance) ────────────────────
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_TIMEOUT=10

# ── Optional ────────────────────────────────────────────────────────────────
# FIREBASE_CREDENTIALS_PATH=/etc/secrets/firebase.json
# FIREBASE_DATABASE_URL=
# ARCHIVE_DELETE_ENABLED=False
# LOG_LEVEL=INFO
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info